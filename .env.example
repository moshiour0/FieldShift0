# Safe local/Vercel environment template. Never put real secrets in this file.
FIELD_SHIFT_LIVE_NASA=1
FIELD_SHIFT_POWER_MAX_IMPUTE_FRACTION=0.10
FIELD_SHIFT_POWER_MAX_GAP_DAYS=5
FIELD_SHIFT_POWER_CACHE_TTL_SECONDS=43200

# Private Google Drive archive; configure as GitHub Actions Secrets and Vercel
# server-side Environment Variables only.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

FIELD_SHIFT_APPEEARS_TOKEN=
